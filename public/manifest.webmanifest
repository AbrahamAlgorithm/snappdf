{
  "id": "/app",
  "name": "snappdf",
  "short_name": "snappdf",
  "description": "Merge, split and sign PDFs, turn photos into PDFs and convert documents. Works offline, nothing is uploaded.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f4f5",
  "theme_color": "#ffffff",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Image to PDF", "url": "/app/image-to-pdf" },
    { "name": "Merge PDF", "url": "/app/merge-pdf" },
    { "name": "Sign PDF", "url": "/app/sign-pdf" }
  ]
}
